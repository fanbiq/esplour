# Copy this file to apps/web/.env and fill in real values.
# apps/web loads its own .env via Next.js — this is separate from apps/mobile.

NODE_ENV=development

# Postgres connection string. Defaults to postgresql://localhost:5432/swiparr if unset.
DATABASE_URL=postgresql://localhost:5432/swiparr

# Which media provider backs the swipe deck: jellyfin | emby | plex | tmdb | native
PROVIDER=tmdb
PROVIDER_LOCK=true

# Must be 32+ characters. Also signs the mobile JWTs (see mobile-jwt.ts) —
# generate with: openssl rand -base64 32
AUTH_SECRET=

# The URL this server is reachable at — the mobile app's FANBIQ_API_URL
# (see apps/mobile/.env.example) should point here.
SERVER_PUBLIC_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000

# If you load the web app itself (in a browser) from another device on your
# LAN — e.g. testing responsive layout on your phone — Next.js will warn/
# block hot-reload requests from that device's IP unless it's listed here.
# Not needed just for the mobile app's API calls. Example:
# NEXT_DEV_ALLOWED_ORIGINS=10.239.124.72,192.168.1.23
# Add any comma-separated dev hosts that should be allowed to access Next.js
# dev-only resources (HMR, etc). Example below includes the reported host.
NEXT_DEV_ALLOWED_ORIGINS=10.239.124.72

# Required if PROVIDER=tmdb
TMDB_ACCESS_TOKEN=

# Required for native email/password signup to send verification emails
RESEND_API_KEY=
FROM_EMAIL=

# Optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_USERNAME=
USE_SECURE_COOKIES=false
