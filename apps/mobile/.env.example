# Copy this file to apps/mobile/.env — Expo CLI loads it automatically on
# `expo start` / `npm run mobile`. Restart Metro after changing it (env vars
# are read once, at config-eval time, not hot-reloaded).

# The same server apps/web's SERVER_PUBLIC_URL points at. Must be reachable
# from your phone/simulator — see the note in the root README about
# localhost not being reachable from a physical device.
FANBIQ_API_URL=http://localhost:3000
